<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/text_compose_panel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/tcpw_material_button_select_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/round_select_all_20"
        android:background="@null"
        android:padding="8dp"
        app:tint="@color/textActionNameColor" />

    <ImageButton
        android:id="@+id/tcpw_material_button_copy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/round_content_copy_20"
        android:background="@null"
        android:padding="8dp"
        app:tint="@color/textActionNameColor" />

    <ImageButton
        android:id="@+id/tcpw_material_button_paste"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/round_content_paste_20"
        android:background="@null"
        android:padding="8dp"
        app:tint="@color/textActionNameColor" />

    <ImageButton
        android:id="@+id/tcpw_material_button_cut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/round_content_cut_20"
        android:background="@null"
        android:padding="8dp"
        app:tint="@color/textActionNameColor" />

    <View
        android:layout_width="1dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/tcpw_material_button_save_to_project"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_more_vert_black_20dp"
        android:background="@null"
        android:padding="8dp"
        app:tint="@color/textActionNameColor" />

</LinearLayout>